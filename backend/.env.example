PORT=4000
# Use a long random value in production (never commit real secrets).
# Production requires a strong, unique secret; default values will be rejected.
JWT_SECRET=change_me
JWT_EXPIRES_IN=8h
JWT_ACCESS_EXPIRES_IN=30m
REFRESH_TOKEN_DAYS=7

# PostgreSQL (local Docker: docker compose up -d)
DATABASE_URL=postgresql://assa:assa@localhost:5432/assa

# Comma-separated list of allowed origins (required in production).
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003

NODE_ENV=development

# Cloudinary connection string for media storage (Option A)
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# Logger verbosity (trace, debug, info, warn, error)
LOG_LEVEL=info

# Domain name for secure session cookies (if needed in production)
# SESSION_COOKIE_DOMAIN=.your-agency-domain.gov.et
SESSION_COOKIE_DOMAIN=

# Groq Cloud API key for the AI Security Assistant (admin dashboard chat widget).
# Leave empty to keep the assistant in simulated/canned-response mode.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
