PORT=4000
# Use a long random value in production.
JWT_SECRET=change_me
JWT_EXPIRES_IN=8h

# SQLite file path. Use an absolute path in production if you mount persistent storage.
DB_PATH=./src/database/assa.db

# Comma-separated list of allowed origins (for browsers). Example:
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003

NODE_ENV=development
