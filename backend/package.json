{
  "name": "assa-backend",
  "version": "1.0.0",
  "description": "ASSA Smart Fisheries System — Backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node prisma/seed.js",
    "reset": "prisma migrate reset --force",
    "simulate:boats": "node scripts/simulate-boats.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "test": "node --test tests/"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "bcryptjs": "2.4.3",
    "cloudinary": "^2.10.0",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "envalid": "^8.0.0",
    "express": "^4.22.2",
    "express-rate-limit": "^8.1.0",
    "express-validator": "7.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "9.0.2",
    "multer": "1.4.5-lts.1",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "nodemon": "3.1.0",
    "prisma": "^6.8.2"
  }
}
